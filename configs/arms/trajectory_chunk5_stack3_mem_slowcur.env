# Trajectory output (chunk 5) WITH multiple images (K=3, stride 3) and box memory, on
# the slow per-scene curriculum (2026-09-25 meeting, Jing). Nothing in the env forbids
# chunking with stacking; the encoder runs each stacked frame through DINO separately.
ENCODER=dinov2
IMGFIX=1
CHUNK=5
FRAMESTACK=3
FRAMESTRIDE=3
BOXMEM=5
BOXMEMAGG=mean
COLLAHEAD=0.7
CURTHRESH=0.75
CURMINEP=100
CURNOTCH=0.25
CURPERSCENE=1
COHTERM=0.4
COHTAU=0.7
COH=50
# ---- STRICT rules from the 2026-09-25 meeting with Jing (same on every fixed arm) ----
REWSRC=either                # a collision on EITHER the generated labels or the fused map is a collision
TRAV=config/traversability_v14_walkway_norough.yaml   # grass AND rough non-traversable (dirt corner keeps a route: 82% blocked, all spawns legal)
COLLTERM=0.01                # >1% of footprint pixels non-traversable ends the episode (was 50%)
CRASHPEN=3000                # crash -30 vs goal +10 (3x)
DISAGREE=20                  # 0.2/step when generated labels and map disagree under the footprint...
DISAGREEFRAC=0.1             # ...meaning one reads >=10% non-traversable and the other <10%; not scored when >=50% of the footprint is map-void
RGBALIGN=100                 # 100 x (0.70 - similarity)/step when the generated frame drifts from the Gaussian raster over alpha>=0.5 pixels
RGBALIGNTAU=0.70             # Joana 2026-09-25: charge only gross drift. Measured: on-trajectory 0.93-0.96, 4-6 m off 0.86-0.88, 100-120 deg yaw ~0.70 (p10 0.69); fires on frames that are becoming a different place
GPUS=4
