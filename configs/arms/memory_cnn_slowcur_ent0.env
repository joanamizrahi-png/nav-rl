# memory_cnn_slowcur with NO entropy bonus (2026-09-25). Every arm so far trained with
# ent_coef=0.01 and its action std stayed at ~1.0 for its whole life: every training
# action was the mean plus noise as wide as the control range, so ep_rew_mean was the
# curve of a half-random controller and understated the deterministic policy that
# eval measures. This arm is the twin of memory_cnn_slowcur with ENT=0, so the std can
# anneal; if its curve separates from the twin's, the entropy bonus was pinning it.
ENCODER=nature
IMGFIX=0
BOXMEM=5
BOXMEMAGG=mean
COLLAHEAD=0.7
CURTHRESH=0.75
CURMINEP=100
CURNOTCH=0.25
CURPERSCENE=1
# Coverage rule (2026-09-25, Joana): terminate below 0.4, graded cost below 0.7.
# COH raised 10 -> 50 so the cost is felt: 50 x (0.7 - cov) x 0.01 = 0.10/step at
# cov 0.5, 0.15 at 0.4. At the base weight of 10 it was 0.02/step -- symbolic.
COHTERM=0.4
COHTAU=0.7
COH=50
ENT=0
GPUS=4
