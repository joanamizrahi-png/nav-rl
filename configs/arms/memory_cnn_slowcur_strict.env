# memory_cnn_slowcur with the STRICT collision rules from the 2026-09-25 meeting:
#   - a collision on EITHER the generated labels or the fused map is a collision (REWSRC=either)
#   - >1% of footprint pixels non-traversable ends the episode (COLLTERM=0.01, was 0.5)
#   - a crash costs 3x the goal bonus (CRASHPEN=3000 -> -30 vs +10)
#   - a per-step cost whenever the two label sources disagree under the footprint (DISAGREE=20 -> 0.2/step)
ENCODER=nature
IMGFIX=0
BOXMEM=5
BOXMEMAGG=mean
COLLAHEAD=0.7
CURTHRESH=0.75
CURMINEP=100
CURNOTCH=0.25
CURPERSCENE=1
COHTERM=0.4
COHTAU=0.7
COH=50
REWSRC=either
#   - rough (dirt/gravel) is NON-traversable (Joana). Checked 2026-09-25: the dirt-corner
#     scenario keeps a route under this table (all 8 spawns legal, case corner), it is just
#     narrower -- 82% of the straight line blocked instead of 52%.
TRAV=config/traversability_v14_walkway_norough.yaml
COLLTERM=0.01
CRASHPEN=3000
DISAGREE=20
DISAGREEFRAC=0.1             # a disagreement = one source reads >=10% of the footprint as non-traversable, the other <10%; NOT tied to COLLTERM=0.01
#   - a per-step cost when the generated frame no longer resembles the Gaussian raster where
#     the raster has alpha >= 0.5: 100 x (0.90 - similarity); at 4-6 m off the walk (sim ~0.86-0.88)
#     that is 0.02-0.04/step, at 100+ deg of yaw (sim ~0.7-0.8) 0.1-0.2/step
RGBALIGN=100
RGBALIGNTAU=0.90            # measured 2026-09-25 (calibrate_rgb_align.py): on-trajectory similarity p10 0.934, median 0.954
GPUS=4
