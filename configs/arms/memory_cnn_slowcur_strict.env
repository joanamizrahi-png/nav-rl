# memory_cnn_slowcur with the STRICT collision rules from the 2026-09-25 meeting:
#   - a collision on EITHER the generated labels or the fused map is a collision (REWSRC=either)
#   - >1% of footprint pixels non-traversable ends the episode (COLLTERM=0.01, was 0.5)
#   - a crash costs 3x the goal bonus (CRASHPEN=3000 -> -30 vs +10)
#   - a per-step cost whenever the two label sources disagree under the footprint (DISAGREE=20 -> 0.2/step)
ENCODER=nature
IMGFIX=0
BOXMEM=5
BOXMEMAGG=mean
COLLAHEAD=0.7
CURTHRESH=0.75
CURMINEP=100
CURNOTCH=0.25
CURPERSCENE=1
COHTERM=0.4
COHTAU=0.7
COH=50
REWSRC=either
COLLTERM=0.01
CRASHPEN=3000
DISAGREE=20
DISAGREEFRAC=0.1             # a disagreement = one source reads >=10% of the footprint as non-traversable, the other <10%; NOT tied to COLLTERM=0.01
#   - a per-step cost when the generated frame no longer resembles the Gaussian raster where
#     the raster has alpha >= 0.5: 100 x (0.8 - similarity), i.e. 0.2/step at similarity 0.6
RGBALIGN=100
RGBALIGNTAU=0.8
GPUS=4
