# memory_dino with the SLOW per-scene distance curriculum and the 0.3 coverage cutoff
# (2026-09-25). Replaces A_dino_slowcur: Joana wants box memory on every arm, and
# A_dino has none. This is the DINOv2 counterpart of memory_cnn_slowcur.
ENCODER=dinov2
IMGFIX=1
BOXMEM=5
BOXMEMAGG=mean
COLLAHEAD=0.7
CURTHRESH=0.75
CURMINEP=100
CURNOTCH=0.25
CURPERSCENE=1
COHTERM=0.3
GPUS=4
