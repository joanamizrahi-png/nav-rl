# memory_dino with the SLOW per-scene distance curriculum and the 0.3 coverage cutoff
# (2026-09-25). Replaces A_dino_slowcur: Joana wants box memory on every arm, and
# A_dino has none. This is the DINOv2 counterpart of memory_cnn_slowcur.
ENCODER=dinov2
IMGFIX=1
BOXMEM=5
BOXMEMAGG=mean
COLLAHEAD=0.7
CURTHRESH=0.75
CURMINEP=100
CURNOTCH=0.25
CURPERSCENE=1
# Coverage rule (2026-09-25, Joana): terminate below 0.4, graded cost below 0.7.
# COH raised 10 -> 50 so the cost is felt: 50 x (0.7 - cov) x 0.01 = 0.10/step at
# cov 0.5, 0.15 at 0.4. At the base weight of 10 it was 0.02/step -- symbolic.
COHTERM=0.4
COHTAU=0.7
COH=50
GPUS=4
