# memory_cnn with a SLOW distance curriculum (2026-09-25). The default gate let every
# arm reach 10 m in 40-60k steps at ~50% success and plateau there; this one earns
# a notch only after a full 100-episode window at 75% success, a quarter metre at a
# time, so the band tracks mastery instead of luck. From scratch, band 2 m.
ENCODER=nature
IMGFIX=0
BOXMEM=5
BOXMEMAGG=mean
COLLAHEAD=0.7
CURTHRESH=0.75
CURMINEP=100
CURNOTCH=0.25
CURPERSCENE=1               # the worst scene decides, not the average
# End the episode at coverage 0.3 instead of 0.1 (2026-09-25, Joana). The sweep
# panels show the generator producing a different place below ~0.1 and the label
# agreement is vacuous below ~0.4; steps taken there train on fiction. The graded
# cost (COH=10 below COHTAU=0.4) is ~0.02/step on the +-10 scale and deters nothing,
# so the cutoff is the only thing that keeps training data honest.
COHTERM=0.3
GPUS=4
