# Corners ramped on the distance curriculum: mix 0 below 5 m, full at the
# 10 m ceiling. Pinning the mix at 1.0 from step zero decayed the mean
# throttle from +0.92 to +0.16 in 30k steps (2026-09-22).
ENCODER=dinov2
IMGFIX=1
BOXMEM=5
BOXMEMAGG=mean
COLLAHEAD=0.7
GOALTURN=45
GOALTURNMIX=1.0
GOALTURNBEYOND=2.0
GOALTURNFROM=5
GPUS=4
