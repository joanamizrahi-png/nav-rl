# trajectory_chunk5 WITH box memory, on the slow per-scene curriculum and the 0.3
# coverage cutoff (2026-09-25, Joana: every arm should have memory). The original
# chunk arms left BOXMEM off for comparability with each other; the cost was that
# their near-field collision box rarely projected and close contacts went unscored.
# Nothing in the env forbids memory with chunking. GPUS=4 like the other fixed arms.
ENCODER=dinov2
IMGFIX=1
CHUNK=5
BOXMEM=5
BOXMEMAGG=mean
COLLAHEAD=0.7
CURTHRESH=0.75
CURMINEP=100
CURNOTCH=0.25
CURPERSCENE=1
# Coverage rule (2026-09-25, Joana): terminate below 0.4, graded cost below 0.7.
# COH raised 10 -> 50 so the cost is felt: 50 x (0.7 - cov) x 0.01 = 0.10/step at
# cov 0.5, 0.15 at 0.4. At the base weight of 10 it was 0.02/step -- symbolic.
COHTERM=0.4
COHTAU=0.7
COH=50
GPUS=4
