# corner_ramped_cnn with the SLOW distance curriculum and the 0.3 coverage cutoff (2026-09-25).
# Same knobs as memory_cnn_slowcur; see that file for the reasoning. From scratch, band 2 m.
ENCODER=nature
IMGFIX=0
BOXMEM=5
BOXMEMAGG=mean
COLLAHEAD=0.7
GOALTURN=45
GOALTURNMIX=1.0
GOALTURNBEYOND=2.0
GOALTURNFROM=5
CURTHRESH=0.75
CURMINEP=100
CURNOTCH=0.25
CURPERSCENE=1               # the worst scene decides, not the average
# Coverage rule (2026-09-25, Joana): terminate below 0.4, graded cost below 0.7.
# COH raised 10 -> 50 so the cost is felt: 50 x (0.7 - cov) x 0.01 = 0.10/step at
# cov 0.5, 0.15 at 0.4. At the base weight of 10 it was 0.02/step -- symbolic.
COHTERM=0.4
COHTAU=0.7
COH=50
GPUS=4
