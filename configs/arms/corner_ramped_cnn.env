# Corners ramped on the distance curriculum, with the Nature CNN and box memory.
# The CNN is our strongest encoder so far (+0.20 mean throttle at 57k against DINO's +0.09),
# and it is also the cheap one on the Jetson (2026-09-22).
ENCODER=nature
IMGFIX=0
BOXMEM=5
BOXMEMAGG=mean
COLLAHEAD=0.7
GOALTURN=45
GOALTURNMIX=1.0
GOALTURNBEYOND=2.0
GOALTURNFROM=5
GPUS=4
