# The eval scene set: goal, spawn bound, and why. ONE place, so no hand-written
# command can drop a parameter again.
#
# SPAWN_MAX matters: with a FIXED goal frame, a spawn drawn AFTER that frame puts
# the goal behind a forward-only robot, which then needs a ~164 deg spin before it
# can move at all. Every arm failed quad2_00 episode 1 for exactly this reason
# (2026-09-23, Joana spotted it in the trajectories).
#
# SPAWN_MAX alone is not enough for a CORNER test: spawning 8 frames before the
# goal puts the robot past the bend, so there is nothing to turn around. The old
# correct runs were named spawn12-22_goal48 -- 26-36 frames of approach, so the
# robot must reach the bend, turn, and continue (2026-09-23, Joana).
#
# format:  <scene> <goal spec> <spawn bounds, comma separated, or ->   # note
EVAL_SCENES="
quad1_01     GOALFRAMERANGE=15,70   -        # open plaza, goals drawn along the walk
quad1_07     GOALFRAMERANGE=15,70   -        # second plaza (duplicate of quad1_01, usually skip)
quad2_00     GOAL_FRAME=48          SPAWN_MIN=12,SPAWN_MAX=22   # corner: spawn WELL BEFORE the bend
sequoia1_10  GOAL_FRAME=30          SPAWN_MIN=5,SPAWN_MAX=18    # pedestrians, NOT in training
sequoia1_17  GOAL_FRAME=72          SPAWN_MIN=40,SPAWN_MAX=56   # lawn corner; 12 m goal, everyone ~0
"
# The three-scene core set: open navigation, turning, and a scene held out of training.
EVAL_CORE="quad1_01 quad2_00 sequoia1_10"
