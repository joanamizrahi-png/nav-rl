<diagram id="p3" name="Losses">
<mxGraphModel dx="1200" dy="800" grid="1" gridSize="20" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="500" math="0" shadow="0"><root>
<mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="ld" value="DIFFUSION (v8):   L = L_rgb + 2.0·L_x0 + 0.1·L_CE + 0.05·L_seg" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="680" height="40" as="geometry"/></mxCell>
<mxCell id="l1" value="L_rgb = ‖v_pred − (ε − x0)‖²   velocity MSE, RGB half (unchanged)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="680" height="40" as="geometry"/></mxCell>
<mxCell id="l2" value="L_x0 = ‖x̂0 − x0‖²   semantic half predicts the CLEAN latent" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="680" height="40" as="geometry"/></mxCell>
<mxCell id="l3" value="L_CE = CrossEntropy( head(decode(x̂0)), GT classes )   at σ ≤ 0.7" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="680" height="40" as="geometry"/></mxCell>
<mxCell id="l4" value="L_seg = CE of each pixel vs its SAM2-segment mean (detached)" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="680" height="40" as="geometry"/></mxCell>
<mxCell id="lr" value="RL REWARD:  r = 1.0·(s_terrain−1) + 1.5·Δd − 1.0·collision − 0.3·void − 0.05 − 0.05·|turn| + 50·[goal]" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="680" height="40" as="geometry"/></mxCell>
<mxCell id="lp" value="PPO:  L = E[ min(ρA, clip(ρ, 0.8, 1.2)·A) ]   lr 1e-4, target_kl 0.02" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="680" height="40" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
